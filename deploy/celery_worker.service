[Unit]
Description=Credit Fund Celery Worker
After=network.target redis-server.service postgresql.service

[Service]
Type=forking
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/credit_fund
EnvironmentFile=/home/ubuntu/.env
ExecStart=/home/ubuntu/venv/bin/celery \
    -A config worker \
    -l warning \
    --concurrency=1 \
    --pidfile=/tmp/celery_worker.pid \
    --logfile=/var/log/credit_fund/celery_worker.log \
    --detach
PIDFile=/tmp/celery_worker.pid
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
